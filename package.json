{
  "name": "a11ign-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Judge the real assistive-technology experience of a website with AI: drive a real screen reader through real navigation and assess whether the experience is coherent and usable.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "npm": "use pnpm instead: run pnpm install"
  },
  "scripts": {
    "mutate": "node packages/guards/src/mutation-check.mjs",
    "guards:sweep": "node packages/guards/src/tree-wide-guards.mjs | xargs node packages/guards/src/assert-glob-not-empty.mjs --min=1 --run --runner=rstest",
    "row-claim": "agent-org row-claim",
    "row-file": "agent-org row-file",
    "board:summary-check": "agent-org board:summary-check",
    "board:liveness": "agent-org board:liveness",
    "npm-token:check": "node scripts/npm-token-liveness.mjs",
    "workflow:liveness": "agent-org workflow:liveness",
    "ready:audit": "agent-org ready:audit",
    "branches:stranded": "agent-org branches:stranded",
    "queue:table": "agent-org queue:table",
    "work:gate": "agent-org work:gate",
    "work:wake": "agent-org work:wake",
    "work:profile": "agent-org work:profile",
    "prompt:session": "agent-org prompt:session",
    "messaging:watch": "agent-org messaging:watch",
    "messaging:pair": "agent-org messaging:pair",
    "messaging:listen": "agent-org messaging:listen",
    "chairman:reply": "agent-org chairman:reply",
    "work:tick": "agent-org work:tick",
    "spawn:cycles": "agent-org spawn:cycles",
    "board:document": "agent-org board:document",
    "tracker:comment": "agent-org tracker:comment",
    "board:record": "agent-org board:record",
    "board:report": "agent-org board:report",
    "board:settle": "agent-org board:settle",
    "hygiene:report": "agent-org hygiene:report",
    "survey": "agent-org survey",
    "spike": "tsx packages/lab/src/harnesses/run-spike.ts",
    "witness": "A11Y_PYTHON=.venv/bin/python tsx packages/cli/src/cli.ts",
    "auth:leak-check": "tsx scripts/auth-leak-check.mjs",
    "auth:artifact-scan": "tsx scripts/auth-artifact-scan.mjs",
    "worker": "node packages/nvda-worker/src/server.mjs",
    "eval": "A11Y_PYTHON=.venv/bin/python tsx packages/lab/src/eval/run.ts",
    "rules-check": "tsx packages/lab/src/eval/rules-check.ts",
    "test": "pnpm run test:ts && pnpm run test:python",
    "test:ts": "node packages/guards/src/assert-glob-not-empty.mjs \"packages/{evidence,judge,scorer,cli,nvda-worker,worker-fleet,nvda-speech,pdf}/src/**/*.test.ts\" --min=180 --run --runner=rstest ${A11Y_TEST_CONCURRENCY:+--test-concurrency=$A11Y_TEST_CONCURRENCY}",
    "test:nightly": "node packages/guards/src/assert-glob-not-empty.mjs \"packages/*/nightly/**/*.test.ts\" --min=1 --run",
    "test:python": "if [ -x .venv/bin/pytest ]; then PYTHONDONTWRITEBYTECODE=1 .venv/bin/pytest -p no:cacheprovider packages/*/tests -q; else echo \"SKIPPED: no .venv/bin/pytest — python tests need it. This is an honest skip, not a pass.\"; fi",
    "eval:capture": "A11Y_PYTHON=.venv/bin/python node packages/lab/src/harnesses/capture-fixtures.mjs",
    "eval:gate": "A11Y_PYTHON=.venv/bin/python EVAL_GATE=1 EVAL_RUNS=3 tsx packages/lab/src/eval/run.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-packages.mjs",
    "preinstall": "node scripts/refuse-other-installers.mjs",
    "prepare": "node scripts/install-git-hooks.mjs && node scripts/build-packages.mjs",
    "lint": "eslint .",
    "scan": "tsx packages/cli/src/scan/run-axe.ts",
    "training:generate": "node packages/lab/src/training/generate-screenreader-dataset.mjs",
    "training:generate-acceptance": "node packages/lab/src/training/generate-screenreader-acceptance.mjs",
    "training:preflight": "node packages/lab/src/training/preflight-screenreader-dataset.mjs",
    "training:preflight-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance node packages/lab/src/training/preflight-screenreader-dataset.mjs",
    "training:capture-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance DATASET_PAGES_PORT=5051 DATASET_BASE_URL=http://localhost:5051 DATASET_CAPTURE_ROOT=captures/${REPEAT:-repeat-1} tsx packages/lab/src/training/capture-screenreader-dataset.mjs",
    "training:export-acceptance": "DATASET_KIND=acceptance DATASET_ROOT=runs/screenreader-acceptance DATASET_CAPTURE_ROOT=captures/${REPEAT:-repeat-1} node packages/lab/src/training/export-screenreader-dataset.mjs --out=runs/screenreader-acceptance/${REPEAT:-repeat-1}.jsonl",
    "training:capture": "tsx packages/lab/src/training/capture-screenreader-dataset.mjs",
    "training:capture:fresh": "node scripts/pnpm.mjs run training:generate && node scripts/pnpm.mjs run training:capture --",
    "training:status": "node packages/lab/src/training/capture-status.mjs",
    "training:wait": "node packages/lab/src/training/wait-for-capture.mjs",
    "scorer:explain": "node packages/lab/scripts/explain-scorer.mjs",
    "training:check-signals": "node packages/lab/src/training/check-signals.mjs",
    "training:check-signals:complete": "node packages/lab/src/training/check-signals.mjs --require-complete",
    "training:build-realism": "node packages/lab/scripts/build-realism-tier.mjs --out=runs/screenreader-dataset/with-realism.jsonl",
    "lab:retrain": "node packages/lab/scripts/retrain-pipeline.mjs",
    "lab:everything": "node packages/lab/scripts/everything-pipeline.mjs",
    "lab:full-page-claims": "node packages/lab/scripts/full-page-claims.mjs",
    "training:export": "node packages/lab/src/training/export-screenreader-dataset.mjs",
    "training:export:test": "A11Y_DATASET_GRADE=test node packages/lab/src/training/export-screenreader-dataset.mjs",
    "training:analyze-errors": ".venv/bin/python packages/lab/scripts/report-screenreader-errors.py",
    "training:evaluate-acceptance": ".venv/bin/python packages/lab/scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl",
    "training:evaluate-acceptance:shipped": "rm -rf runs/model-shipped && mkdir -p runs && cp -r packages/scorer/models/screenreader-scorer runs/model-shipped && .venv/bin/python packages/lab/scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl --model runs/model-shipped --training-report runs/model-shipped/training-report.json --out runs/model-shipped/acceptance-report.json",
    "training:score": ".venv/bin/python packages/scorer/python/score.py",
    "training:shadow": ".venv/bin/python packages/scorer/python/score.py --shadow",
    "training:hardening": ".venv/bin/python packages/lab/scripts/check-screenreader-hardening.py",
    "training:fetch-encoder": ".venv/bin/python packages/scorer/python/fetch-encoder.py",
    "training:train": "node packages/lab/scripts/build-realism-tier.mjs --out=runs/screenreader-dataset/with-realism.jsonl && .venv/bin/python packages/lab/scripts/train-screenreader-model.py --data runs/screenreader-dataset/with-realism.jsonl --output runs/model-candidate",
    "training:train-baseline": ".venv/bin/python packages/lab/scripts/train-screenreader-model.py --output runs/model-baseline",
    "doctor": "node packages/control/src/with-control-plane-fleet.mjs packages/worker-fleet/src/doctor.mjs",
    "primary:mark": "agent-org primary:mark",
    "worker:code": "node packages/control/src/with-control-plane-fleet.mjs packages/worker-fleet/src/check-worker-code.mjs",
    "worker:deploy": "node packages/worker-fleet/src/deploy-worker.mjs",
    "worker:compare": "node packages/worker-fleet/src/compare-workers.mjs",
    "evidence:check": "tsx packages/lab/scripts/evidence-check.mjs",
    "guest:run": "node packages/worker-fleet/src/guest-run.mjs",
    "gate:stability": "tsx packages/lab/scripts/stability-gate.mjs",
    "gate:nvda-release": "node packages/lab/scripts/nvda-release-gate.mjs",
    "gate:isolation": "node packages/guards/src/isolation-gate.mjs --all",
    "gate:registry": "node scripts/registry-consumer-gate.mjs",
    "fleet:normalise": "node packages/worker-fleet/src/normalise-fleet.mjs",
    "fleet:env": "node packages/worker-fleet/src/fleet-env.mjs",
    "fleet:status": "node packages/control/src/fleet-status.mjs",
    "fleet:link-view": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/fleet-link-view.yml",
    "fleet:discover": "node packages/control/src/fleet-discover.mjs",
    "fleet:wake": "node packages/control/src/fleet-wake.mjs",
    "fleet:auto-off": "node packages/control/src/fleet-auto-off.mjs",
    "fleet:auto-off-schedule": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/auto-off-schedule.yml",
    "lab:job": "node packages/control/src/lab-job.mjs",
    "lab:pipeline": "node packages/control/src/lab-pipeline.mjs",
    "lab:failed-units": "node packages/control/src/lab-failed-units.mjs",
    "lab:watch": "node packages/control/src/lab-watch.mjs",
    "fleet:watch": "node packages/control/src/fleet-watch.mjs",
    "lab:status": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/lab-status.yml",
    "lab:log": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/lab-log.yml",
    "lab:inventory": "node packages/lab/scripts/lab-inventory.mjs",
    "fleet:tailscale": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/tailscale.yml",
    "fleet:deploy": "node packages/control/src/fleet-playbook.mjs --playbook=deploy.yml",
    "fleet:sleep": "node packages/control/src/fleet-playbook.mjs --playbook=sleep.yml",
    "fleet:provision": "node packages/control/src/fleet-playbook.mjs --playbook=provision-role.yml",
    "lab:fetch": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/lab-fetch.yml",
    "lab:stop": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/lab-stop.yml",
    "lab:clear-failed": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/lab-clear-failed.yml",
    "lab:reset": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/lab-reset.yml",
    "lab:corpus-schedule": "ANSIBLE_CONFIG=packages/control/ansible/ansible.cfg ansible-playbook packages/control/ansible/corpus-schedule.yml",
    "corpus:snapshot": "node packages/lab/scripts/corpus-snapshot.mjs",
    "corpus:prune-orphans": "node packages/lab/scripts/corpus-prune-orphans.mjs",
    "corpus:backup": "node packages/lab/scripts/corpus-backup.mjs",
    "training:repeat": "tsx packages/lab/src/training/repeat-capture.mjs",
    "rules:score": "tsx packages/lab/scripts/score-rules.ts",
    "rules:gate": "tsx packages/lab/scripts/score-rules.ts --gate",
    "rules:coverage": "tsx packages/lab/scripts/audit-rule-coverage.ts",
    "rescue:hunk": "agent-org rescue:hunk",
    "rules:real-pages": "tsx packages/lab/scripts/check-real-page-findings.ts",
    "scorer:migration": "node scripts/check-schema-migration.mjs",
    "scorer:retired-heads": "node scripts/check-retired-heads.mjs",
    "scorer:shortcuts": "node scripts/pnpm.mjs run --silent corpus:unclosable-map && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python packages/lab/scripts/audit-scorer-shortcuts.py --data runs/screenreader-dataset/with-realism.jsonl",
    "promote:model": "node packages/lab/scripts/promote-model.mjs",
    "docs:coverage": "tsx packages/lab/scripts/generate-coverage-doc.ts",
    "docs:known-gaps-index": "node scripts/known-gaps-index.mjs",
    "corpus:starvation": "node packages/lab/scripts/audit-corpus-starvation.mjs",
    "corpus:unclosable-map": "node packages/lab/scripts/emit-unclosable-vetoes.mjs",
    "corpus:grants-map": "node packages/lab/scripts/emit-grants-map.mjs",
    "corpus:grants-audit": "node scripts/pnpm.mjs run --silent corpus:grants-map && .venv/bin/python packages/scorer/python/audit_grants.py",
    "corpus:container-exits": ".venv/bin/python packages/scorer/python/audit_container_exits.py",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "release:version": "changeset version && node scripts/pnpm.mjs install --lockfile-only",
    "release:gate:ci": "node scripts/pnpm.mjs run scorer:verify && node scripts/pnpm.mjs run release:provenance && node scripts/pnpm.mjs run release:rehearsal-check && node scripts/pnpm.mjs run scorer:migration && node scripts/pnpm.mjs run gate:isolation",
    "release:gate": "node scripts/pnpm.mjs run scorer:verify && node scripts/pnpm.mjs run release:provenance && node scripts/pnpm.mjs run release:rehearsal-check && node scripts/pnpm.mjs run scorer:migration && node scripts/pnpm.mjs run scorer:shortcuts && node scripts/pnpm.mjs run gate:isolation && node scripts/pnpm.mjs run corpus:distribution && node scripts/pnpm.mjs run training:check-signals:complete && node scripts/pnpm.mjs run rules:gate && node scripts/pnpm.mjs run rules:coverage && node scripts/pnpm.mjs run rules:real-pages && node scripts/pnpm.mjs run training:evaluate-acceptance:shipped && node scripts/pnpm.mjs run gate:nvda-release && node scripts/pnpm.mjs run eval:gate",
    "capture:check": "tsx packages/lab/src/harnesses/capture-check.mjs",
    "capture:explain": "node packages/lab/scripts/explain-capture.mjs",
    "layers:compare": "A11Y_PYTHON=.venv/bin/python node packages/lab/scripts/compare-layers.mjs",
    "pretest": "node scripts/pnpm.mjs run build",
    "pretypecheck": "node scripts/pnpm.mjs run build",
    "worker:ctl": "packages/worker-fleet/src/local-worker/worker-ctl.sh",
    "worktrees:prune": "agent-org worktrees:prune",
    "primary:update": "agent-org primary:update",
    "coverage": "node scripts/coverage.mjs",
    "identity:rate": "tsx packages/lab/src/harnesses/page-identity-rate.mjs",
    "verdict:stability": "tsx packages/lab/src/harnesses/occurrence-verdict-stability.mjs",
    "verdict:preregistered": "node packages/lab/scripts/check-preregistered-verdict.mjs",
    "training:export-acceptance:all": "REPEAT=repeat-1 node scripts/pnpm.mjs run --silent training:export-acceptance && REPEAT=repeat-2 node scripts/pnpm.mjs run --silent training:export-acceptance",
    "scorer:size-sensitivity": "node packages/lab/scripts/audit-size-sensitivity.mjs",
    "candidate:gate": "node scripts/pnpm.mjs run scorer:migration -- --evaluating && node scripts/pnpm.mjs run scorer:retired-heads && node scripts/pnpm.mjs run scorer:shortcuts -- --model runs/model-candidate --data runs/screenreader-dataset/with-realism.jsonl && node scripts/pnpm.mjs run gate:isolation && node scripts/pnpm.mjs run training:check-signals:complete && node scripts/pnpm.mjs run rules:gate && node scripts/pnpm.mjs run rules:coverage && node scripts/pnpm.mjs run rules:real-pages",
    "promote:gated": "node scripts/pnpm.mjs run --silent candidate:gate && node scripts/pnpm.mjs run --silent promote:model --",
    "scorer:shortcuts:baseline": "node scripts/pnpm.mjs run --silent corpus:unclosable-map && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python packages/lab/scripts/audit-scorer-shortcuts.py --data runs/screenreader-dataset/with-realism.jsonl --update-baseline",
    "scorer:shortcuts:candidate": "node scripts/pnpm.mjs run --silent corpus:unclosable-map && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python packages/lab/scripts/audit-scorer-shortcuts.py --model runs/model-candidate --data runs/screenreader-dataset/with-realism.jsonl --no-baseline",
    "training:evaluate-acceptance:candidate": ".venv/bin/python packages/lab/scripts/evaluate-screenreader-acceptance.py --data runs/screenreader-acceptance/repeat-1.jsonl --data runs/screenreader-acceptance/repeat-2.jsonl --training-data runs/screenreader-dataset/with-realism.jsonl --model runs/model-candidate --training-report runs/model-candidate/training-report.json --out runs/model-candidate/acceptance-report.json",
    "corpus:applicability-audit": ".venv/bin/python packages/scorer/python/audit_applicability.py",
    "corpus:urls": "node packages/lab/scripts/audit-corpus-urls.mjs",
    "scorer:verify": "node packages/lab/scripts/verify-safetensors.mjs packages/scorer/models/screenreader-scorer",
    "release:provenance": "node packages/lab/scripts/check-shipped-provenance.mjs",
    "release:rehearsal-check": "node packages/lab/scripts/check-rehearsal-currency.mjs",
    "corpus:distribution": "node packages/lab/scripts/check-dataset-distribution.mjs",
    "scorer:explain-feature": ".venv/bin/python packages/scorer/python/explain_feature.py",
    "corpus:observation-ambiguity": "node packages/lab/scripts/audit-observation-ambiguity.mjs",
    "corpus:route-change-identity": "node packages/lab/scripts/audit-route-change-identity.mjs",
    "corpus:focus-log-first-event": "node packages/lab/scripts/audit-focus-log-first-event.mjs",
    "gate:probe-order": "node packages/lab/scripts/gate-probe-order.mjs",
    "lab:collect-promotion": "node packages/lab/scripts/collect-promotion.mjs",
    "scorer:shortcuts:baseline:candidate": "node scripts/pnpm.mjs run --silent corpus:unclosable-map && .venv/bin/python packages/lab/scripts/audit-scorer-shortcuts.py --model runs/model-candidate --data runs/screenreader-dataset/with-realism.jsonl --update-baseline",
    "fleet:recover": "node packages/control/src/fleet-playbook.mjs --playbook=recover.yml",
    "fleet:logs": "node packages/control/src/fleet-playbook.mjs --playbook=collect-logs.yml",
    "fleet:os-rollback": "node packages/control/src/fleet-playbook.mjs --playbook=os-rollback.yml",
    "fleet:hours": "node packages/lab/scripts/fleet-hours.mjs",
    "fleet:inventory-install": "node packages/control/src/fleet-playbook.mjs --playbook=inventory-install.yml",
    "fleet:control-host-install": "node packages/control/src/fleet-playbook.mjs --playbook=control-host-install.yml",
    "corpus:release": "node packages/lab/scripts/corpus-release.mjs",
    "corpus:release-nightly": "node packages/lab/scripts/corpus-release-nightly.mjs",
    "fleet:batch-now": "agent-org fleet:batch-now",
    "host:check": "agent-org host:check",
    "host:install": "agent-org host:install",
    "stash:whose": "agent-org stash:whose",
    "pr:hold": "agent-org pr:hold",
    "pr:release": "agent-org pr:release",
    "pr:open": "agent-org pr:open",
    "pr:edit": "agent-org pr:edit",
    "branches:inventory": "agent-org branches:inventory",
    "worktree:whose": "agent-org worktree:whose",
    "worktree:stamp": "agent-org worktree:stamp",
    "test:org": "node packages/guards/src/assert-glob-not-empty.mjs \"packages/{agent-org,guards,lab,control}/src/**/*.test.ts\" --min=300 --run --runner=rstest ${A11Y_TEST_CONCURRENCY:+--test-concurrency=$A11Y_TEST_CONCURRENCY}",
    "test:all": "node packages/guards/src/assert-glob-not-empty.mjs \"packages/*/src/**/*.test.ts\" --min=500 --run --runner=rstest ${A11Y_TEST_CONCURRENCY:+--test-concurrency=$A11Y_TEST_CONCURRENCY}",
    "test:changed": "node scripts/test-changed.mjs"
  },
  "dependencies": {
    "@a11ign/evidence": "0.0.0",
    "@a11ign/judge": "0.0.0",
    "@a11ign/scorer": "0.0.0",
    "@a11ign/screenreader-fleet": "0.0.0",
    "@a11ign/screenreader-worker": "0.0.0",
    "@anthropic-ai/sdk": "^0.129.0",
    "@guidepup/guidepup": "^0.31.0",
    "a11ign": "0.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "^10.0.1",
    "@guidepup/setup": "0.25.2",
    "@rstest/core": "0.11.12",
    "@rstest/coverage-v8": "0.11.12",
    "@types/node": "^26.6.3",
    "agent-org": "github:a11ign/agent-org#semver:^0.2.0",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "playwright": "^1.61.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
