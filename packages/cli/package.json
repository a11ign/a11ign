{
  "name": "a11ign",
  "version": "0.4.1",
  "description": "Drives a real screen reader through a real page and reports the WCAG 2.2 AA failures a rule scanner cannot see — alongside axe, never instead of it.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "a11ign": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@a11ign/evidence": "0.3.0",
    "@a11ign/judge": "0.3.0",
    "@a11ign/scorer": "0.3.0",
    "@a11ign/screenreader-fleet": "^0.5.1"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@a11ign/documents": "^0.1.0",
    "@a11ign/toolchain": "0.1.3",
    "axe-core": "^4.13.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/a11ign.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/a11ign/a11ign",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "screen-reader",
    "nvda",
    "axe",
    "cli"
  ]
}
