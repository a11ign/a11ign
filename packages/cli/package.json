{
  "name": "a11ign",
  "version": "0.2.7",
  "description": "Drives a real screen reader through a real page and reports the WCAG 2.2 AA failures a rule scanner cannot see — alongside axe, never instead of it.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "a11ign": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@a11ign/evidence": "0.2.0",
    "@a11ign/judge": "0.2.3",
    "@a11ign/documents": "^0.1.0",
    "@a11ign/scorer": "0.2.1",
    "@a11ign/screenreader-fleet": "^0.3.0",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "axe-core": "^4.13.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "tsc --build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/a11ign.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/a11ign/a11ign",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "screen-reader",
    "nvda",
    "axe",
    "cli"
  ]
}
