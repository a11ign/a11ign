{
  "name": "@a11ign/judge",
  "version": "0.2.3",
  "description": "Judges a screen-reader capture against WCAG 2.2 AA: the trained local scorer by default, the deterministic absence rules, and the experience-layer ordering.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./layers": {
      "types": "./dist/layers.d.ts",
      "default": "./dist/layers.mjs"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.mjs"
    },
    "./coverage": {
      "types": "./dist/coverage.d.ts",
      "default": "./dist/coverage.mjs"
    },
    "./outcomes": {
      "types": "./dist/outcomes.d.ts",
      "default": "./dist/outcomes.mjs"
    },
    "./act-rules": {
      "types": "./dist/act-rules.d.ts",
      "default": "./dist/act-rules.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@a11ign/evidence": "0.2.0"
  },
  "peerDependencies": {
    "@a11ign/scorer": "0.2.1",
    "@anthropic-ai/sdk": ">=0.106.0 <0.132.0",
    "@huggingface/transformers": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/a11ign.git",
    "directory": "packages/judge"
  },
  "homepage": "https://github.com/a11ign/a11ign",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "screen-reader",
    "nvda",
    "judge"
  ],
  "devDependencies": {
    "@a11ign/toolchain": "0.1.4"
  }
}
