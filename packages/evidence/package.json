{
  "name": "@a11ign/evidence",
  "version": "0.2.0",
  "description": "The shared evidence contract for screen-reader accessibility captures: wire types, pure verification predicates, and the WCAG 2.2 AA criteria list. Zero dependencies, no I/O.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.mjs"
    },
    "./wcag": {
      "types": "./dist/wcag.d.ts",
      "default": "./dist/wcag.mjs"
    },
    "./document-identity": {
      "types": "./dist/document-identity.d.ts",
      "default": "./dist/document-identity.mjs"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.mjs"
    },
    "./earl": {
      "types": "./dist/earl.d.ts",
      "default": "./dist/earl.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/a11ign.git",
    "directory": "packages/evidence"
  },
  "homepage": "https://github.com/a11ign/a11ign",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "screen-reader",
    "nvda"
  ],
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build"
  }
}
