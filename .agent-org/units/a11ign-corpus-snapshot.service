[Unit]
# THE CORPUS'S DEFENCE ON THE AGENT HOST -- #1798. `corpus-snapshot.mjs`'s own comment calls
# `runs/board-snapshots` "the only evidence" behind the daily board document's published numbers, and
# ceo's ruling on this row (#1798, comment 2026-09-21T07:50:36Z) found it protects ZERO of that on the
# lab: `runs/board-snapshots` accumulates only on THIS host, via `board-snapshot.mjs`'s
# `withBoardSnapshot`, called from `row-claim.mjs`/`row-file.mjs`/`close-rows-for-merged-pr.mjs`/
# `ready-label-audit.mjs` -- every org session, since the 2026-09-13 cutover. The lab's own
# `a11y-corpus-snapshot.timer` (`a11ign/control`'s `ansible/files/`) stays unchanged and keeps protecting
# `captures`/`real-page-corpus`/`screenreader-acceptance` there; this pair is the agent-host half, not a
# replacement for it.
Description=a11ign: snapshot the corpus roots this host actually holds (runs/board-snapshots)
After=herdr.service

[Service]
Type=oneshot
WorkingDirectory=/home/agent/repos/a11y-witness

# SAME REASON a11ign-work-tick.service STATES ITS OWN: a systemd unit gets no login shell's PATH, and
# `corpus-snapshot.mjs` spawns `tar` via `execFile` -- without this it cannot find it and fails silently
# under a oneshot unit's default empty PATH.
Environment=PATH=/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/agent

# V8'S COMPILE CACHE GOES UNDER THE HOME, NOT /tmp -- #2458. `tsc`, `eslint`, `rstest` and `changeset` (all reached
# through `pnpm run`) call `enableCompileCache()` with no directory, which writes `<tmpdir>/node-compile-cache`:
# one entry per file per checkout path, 141,353 inodes in the 2026-09-25 outage. A unit reads no shell startup
# file, so this line is the ONLY place a unit can get it; `host-units.test.ts` pins it on every shipped service.
Environment=NODE_COMPILE_CACHE=%h/.cache/node-compile-cache

# WHICH ACCOUNT THIS SPENDS, DECLARED -- #3641, AND NOT THE HUMAN ONE. A unit has no `HERDR_WORKSPACE_ID`, so
# the `gh` wrapper's rule 5 sends one that declares no `GH_CONFIG_DIR` to `~/.config/gh`, which is logged in as
# `DanBeckDev`, the org owner. This job reaches no `gh` today (it spawns `tar`), which is why `host:check`
# never flagged it, but it is one `pnpm run` away from spending that account. It takes the LEAST-privileged
# one (the workers account); a future `gh` write the workers account lacks is the moment to pick `leads/gh`.
Environment=GH_CONFIG_DIR=/home/agent/workers/gh

# THE SCRIPT IS THE LAB'S, RUN FROM THE LAB'S CHECKOUT (ADR 0045 cut 9, #5087). This repository no longer holds `corpus:snapshot` or lays the lab: the unit names
# `a11ign/lab`'s `scripts/corpus-snapshot.ts` by its absolute path and keeps THIS directory as the working one, because the script reads `runs/` and writes
# `backups` relative to the working directory and what it protects is `runs/board-snapshots` HERE. Node resolves the script's imports from the file, not from
# the working directory. The load is proved FIRST for the reason `a11ign-fleet-watch.service` gives (#4693): a crash before `main` must fail the unit and not
# vanish as a quiet one. The module's own `main` runs only as the entry point, so importing it reads nothing.
ExecStartPre=%h/.local/bin/node -e "import('%h/repos/lab/scripts/corpus-snapshot.ts')"

ExecStart=%h/.local/bin/node %h/repos/lab/scripts/corpus-snapshot.ts

[Install]
WantedBy=default.target
